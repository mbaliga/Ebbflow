<?xml version="1.0" encoding="utf-8"?>
<!-- pads template, medium (about 4x2): title, status line and two pads side by side. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.Ebbflow.Root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            style="@style/Widget.Ebbflow.Title" />

        <TextView
            android:id="@+id/w_as_of"
            style="@style/Widget.Ebbflow.AsOf" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_glyph"
            style="@style/Widget.Ebbflow.Glyph" />

        <TextView
            android:id="@+id/w_value"
            style="@style/Widget.Ebbflow.Value" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="horizontal">

        <Button
            android:id="@+id/w_pad1"
            style="@style/Widget.Ebbflow.Pad" />

        <Button
            android:id="@+id/w_pad2"
            style="@style/Widget.Ebbflow.Pad"
            android:layout_marginStart="@dimen/widget_gap" />
    </LinearLayout>
</LinearLayout>
