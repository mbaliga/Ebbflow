<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for the Quality history widget: sample content only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.Ebbflow.Root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Widget.Ebbflow.Title"
            android:text="@string/widget_title_history" />

        <TextView
            style="@style/Widget.Ebbflow.AsOf"
            android:text="@string/widget_preview_time" />
    </LinearLayout>

    <TextView
        style="@style/Widget.Ebbflow.Caption"
        android:text="@string/widget_history_subtitle" />

    <ImageView
        style="@style/Widget.Ebbflow.Chart"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/widget_name_history"
        android:src="@drawable/widget_preview_sparkline" />

    <TextView
        style="@style/Widget.Ebbflow.Caption"
        android:layout_marginTop="4dp"
        android:text="@string/widget_preview_history_caption" />
</LinearLayout>
