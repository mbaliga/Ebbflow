<?xml version="1.0" encoding="utf-8"?>
<!-- stat / card template, medium (about 4x2): title and as-of time, shape + value, up to three stats. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.Ebbflow.Root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            style="@style/Widget.Ebbflow.Title" />

        <TextView
            android:id="@+id/w_as_of"
            style="@style/Widget.Ebbflow.AsOf" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_glyph"
            style="@style/Widget.Ebbflow.Glyph" />

        <TextView
            android:id="@+id/w_value"
            style="@style/Widget.Ebbflow.Value" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/w_stat1"
            style="@style/Widget.Ebbflow.StatColumn">

            <TextView
                android:id="@+id/w_stat1_name"
                style="@style/Widget.Ebbflow.Caption" />

            <TextView
                android:id="@+id/w_stat1_value"
                style="@style/Widget.Ebbflow.StatValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_stat2"
            style="@style/Widget.Ebbflow.StatColumn">

            <TextView
                android:id="@+id/w_stat2_name"
                style="@style/Widget.Ebbflow.Caption" />

            <TextView
                android:id="@+id/w_stat2_value"
                style="@style/Widget.Ebbflow.StatValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_stat3"
            style="@style/Widget.Ebbflow.StatColumn">

            <TextView
                android:id="@+id/w_stat3_name"
                style="@style/Widget.Ebbflow.Caption" />

            <TextView
                android:id="@+id/w_stat3_value"
                style="@style/Widget.Ebbflow.StatValue" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
