<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for the Stored on this phone widget: sample content only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.Ebbflow.Root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Widget.Ebbflow.Title"
            android:text="@string/widget_title_stored" />

        <TextView
            style="@style/Widget.Ebbflow.AsOf" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Widget.Ebbflow.Glyph"
            android:text="○" />

        <TextView
            style="@style/Widget.Ebbflow.Value"
            android:text="@string/widget_raw_off" />
    </LinearLayout>

    <TextView
        style="@style/Widget.Ebbflow.Caption"
        android:text="@string/widget_preview_count" />
</LinearLayout>
