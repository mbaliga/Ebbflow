<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for the Capture shortcut widget: sample content only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.Ebbflow.Root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Widget.Ebbflow.Title"
            android:text="@string/widget_title_capture" />

        <TextView
            style="@style/Widget.Ebbflow.AsOf" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Widget.Ebbflow.Glyph"
            android:text="■" />

        <TextView
            style="@style/Widget.Ebbflow.Value"
            android:text="@string/widget_status_stopped" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="horizontal">

        <Button
            style="@style/Widget.Ebbflow.Pad"
            android:text="@string/widget_pad_connect" />

        <Button
            style="@style/Widget.Ebbflow.Pad"
            android:layout_marginStart="@dimen/widget_gap"
            android:text="@string/widget_pad_bluetooth" />
    </LinearLayout>
</LinearLayout>
