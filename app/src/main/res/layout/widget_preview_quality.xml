<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for the Signal quality widget: sample content only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/Widget.Ebbflow.Root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Widget.Ebbflow.Title"
            android:text="@string/widget_title_quality" />

        <TextView
            style="@style/Widget.Ebbflow.AsOf"
            android:text="@string/widget_preview_as_of" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Widget.Ebbflow.Glyph"
            android:text="●" />

        <TextView
            style="@style/Widget.Ebbflow.Value"
            android:text="@string/widget_signal_good" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout style="@style/Widget.Ebbflow.StatColumn">

            <TextView
            style="@style/Widget.Ebbflow.Caption"
                android:text="@string/widget_usable" />

            <TextView
            style="@style/Widget.Ebbflow.StatValue"
                android:text="@string/widget_preview_usable" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.Ebbflow.StatColumn">

            <TextView
            style="@style/Widget.Ebbflow.Caption"
                android:text="@string/widget_clipped" />

            <TextView
            style="@style/Widget.Ebbflow.StatValue"
                android:text="@string/widget_preview_clipped" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.Ebbflow.StatColumn">

            <TextView
            style="@style/Widget.Ebbflow.Caption"
                android:text="@string/widget_flatline" />

            <TextView
            style="@style/Widget.Ebbflow.StatValue"
                android:text="@string/widget_preview_flatline" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
